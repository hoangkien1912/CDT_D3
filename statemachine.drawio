<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device">
<diagram id="p1" name="1. Bật tắt hệ thống"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MÁY TRẠNG THÁI BẬT / TẮT HỆ THỐNG" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1320" height="45" as="geometry"/></mxCell><mxCell id="sub" value="Hai trạng thái tổng; STOP được ưu tiên hơn START." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="65" as="geometry"/></mxCell><mxCell id="off" value="MAIN_SYS_OFF&#xa;HỆ THỐNG TẮT&#xa;Toàn bộ đầu ra tắt" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="180" y="260" width="320" height="130" as="geometry"/></mxCell><mxCell id="on" value="MAIN_SYS_ON&#xa;HỆ THỐNG BẬT&#xa;Băng tải chạy" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="870" y="260" width="320" height="130" as="geometry"/></mxCell><mxCell id="init" value="" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="210" width="24" height="24" as="geometry"/></mxCell><mxCell id="e1" value="Khởi tạo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="init" target="off"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="I0 = 1 VÀ I1 = 0&#xa;→ Bật băng tải" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="off" target="on"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="215"/><mxPoint x="1030" y="215"/></Array></mxGeometry></mxCell><mxCell id="e3" value="I1 = 1 HOẶC cờ hết 30 giây = 1&#xa;→ Tắt toàn bộ đầu ra và reset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="on" target="off"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="480"/><mxPoint x="340" y="480"/></Array></mxGeometry></mxCell><mxCell id="reset" value="KHI CHUYỂN SANG HỆ THỐNG TẮT&#xa;• Phân loại chai → HEAD_IDLE.&#xa;• Bộ đếm → TM_RESET; xóa cờ hết 30 giây.&#xa;• Cả 4 trạm → IDLE; xóa mọi hàng chờ và mốc thời gian của trạm.&#xa;• Hủy chu trình đang làm; tắt băng tải, mọi cơ cấu và LED xác nhận." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="160" y="555" width="1080" height="165" as="geometry"/></mxCell><mxCell id="start" value="START được xét theo mức: nếu vẫn giữ START sau khi STOP nhả, hệ thống có thể bật lại.&#xa;Bộ đếm được xét trước trạng thái tổng, nên cờ hết 30 giây làm tắt hệ thống ngay trong cùng lượt cập nhật." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="160" y="725" width="1080" height="65" as="geometry"/></mxCell><mxCell id="legend" value="QUY ƯỚC CHUNG&#xa;I0: START · I1: STOP · I2/I3: cảm biến chai dưới/trên · I4/I5/I6: vị trí chiết/đóng nắp/dán nhãn.&#xa;1 = tác động, 0 = nhả; tín hiệu đã chống dội 20 mẫu liên tiếp. VÀ: phải đủ mọi điều kiện; HOẶC: chỉ cần một điều kiện.&#xa;Nhãn mũi tên: điều kiện → tác động. Nếu chưa thỏa điều kiện chuyển thì giữ trạng thái hiện tại.&#xa;Các máy trạng thái được cập nhật liên tục; các trạm có thể hoạt động đồng thời. Hàng chờ tối đa 255 yêu cầu; đầy thì bỏ yêu cầu mới." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1320" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p2" name="2. Tự tắt 30 giây"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MÁY TRẠNG THÁI TỰ TẮT SAU 30 GIÂY" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1320" height="45" as="geometry"/></mxCell><mxCell id="sub" value="Chỉ theo dõi I2 và I3; không kiểm tra các trạm phía sau còn chai hay đang xử lý." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="65" as="geometry"/></mxCell><mxCell id="a" value="TM_RESET&#xa;CHỜ ĐẾM&#xa;Cờ hết 30 giây = 0" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="160" y="220" width="300" height="110" as="geometry"/></mxCell><mxCell id="b" value="TM_COUNTING&#xa;ĐANG ĐẾM VẮNG CHAI" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="220" width="300" height="110" as="geometry"/></mxCell><mxCell id="c" value="TM_TRIGGER&#xa;ĐÃ HẾT 30 GIÂY&#xa;Giữ cờ hết giờ = 1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="515" width="300" height="110" as="geometry"/></mxCell><mxCell id="init" value="" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="210" width="24" height="24" as="geometry"/></mxCell><mxCell id="e1" value="Khởi tạo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="init" target="a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Hệ thống BẬT VÀ I2 = 0 VÀ I3 = 0&#xa;→ Ghi thời điểm bắt đầu đếm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;exitX=1;exitY=0.2;entryX=0;entryY=0.2;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="190"/></Array></mxGeometry></mxCell><mxCell id="e3" value="I2 = 1 HOẶC I3 = 1&#xa;→ Hủy lần đếm hiện tại" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.3;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="b" target="a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="390"/><mxPoint x="310" y="390"/></Array></mxGeometry></mxCell><mxCell id="e4" value="I2 = 0 VÀ I3 = 0&#xa;VÀ thời gian đã đếm ≥ 30.000 ms&#xa;→ Đặt cờ hết giờ = 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="Hệ thống chuyển sang TẮT&#xa;→ Xóa cờ hết giờ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;entryX=0.2;entryY=1;" edge="1" parent="1" source="c" target="a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="570"/><mxPoint x="650" y="445"/><mxPoint x="220" y="445"/></Array></mxGeometry></mxCell><mxCell id="rule" value="RESET ƯU TIÊN ÁP DỤNG CHO MỌI TRẠNG THÁI&#xa;Khi hệ thống TẮT → TM_RESET và cờ hết giờ = 0.&#xa;Nếu cảm biến tác động đúng lúc đạt ngưỡng 30 giây, ưu tiên hủy đếm.&#xa;TM_TRIGGER giữ cờ cho đến khi hệ thống tắt; cờ này được xử lý ngay trong cùng lượt cập nhật." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="160" y="665" width="1040" height="115" as="geometry"/></mxCell><mxCell id="legend" value="QUY ƯỚC CHUNG&#xa;I0: START · I1: STOP · I2/I3: cảm biến chai dưới/trên · I4/I5/I6: vị trí chiết/đóng nắp/dán nhãn.&#xa;1 = tác động, 0 = nhả; tín hiệu đã chống dội 20 mẫu liên tiếp. VÀ: phải đủ mọi điều kiện; HOẶC: chỉ cần một điều kiện.&#xa;Nhãn mũi tên: điều kiện → tác động. Nếu chưa thỏa điều kiện chuyển thì giữ trạng thái hiện tại.&#xa;Các máy trạng thái được cập nhật liên tục; các trạm có thể hoạt động đồng thời. Hàng chờ tối đa 255 yêu cầu; đầy thì bỏ yêu cầu mới." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1320" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p3" name="3. Phân loại chai"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MÁY TRẠNG THÁI PHÂN LOẠI CHAI" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1320" height="45" as="geometry"/></mxCell><mxCell id="sub" value="Cửa sổ xác nhận 200 ms ghi nhớ sự kiện; không yêu cầu cảm biến giữ liên tục suốt 200 ms." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="65" as="geometry"/></mxCell><mxCell id="a" value="HEAD_IDLE&#xa;CHỜ CHAI" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="205" width="300" height="100" as="geometry"/></mxCell><mxCell id="init" value="" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="210" width="24" height="24" as="geometry"/></mxCell><mxCell id="e1" value="Khởi tạo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="init" target="a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="HEAD_CONFIRM&#xa;ĐANG XÁC NHẬN&#xa;Ghi nhớ I2 và I2/I3 cùng tác động" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="930" y="205" width="350" height="110" as="geometry"/></mxCell><mxCell id="c" value="HEAD_WAIT_CLEAR&#xa;CHỜ VÙNG KIỂM TRA TRỐNG" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="930" y="460" width="350" height="100" as="geometry"/></mxCell><mxCell id="e2" value="Hệ thống BẬT VÀ (I2 = 1 HOẶC I3 = 1)&#xa;→ Bắt đầu 200 ms; ghi nhận tín hiệu ban đầu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Thời gian từ lúc bắt đầu ≥ 200 ms&#xa;→ Phân loại theo bảng bên dưới" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="I2 = 0 VÀ I3 = 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;entryX=0.5;entryY=1;" edge="1" parent="1" source="c" target="a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="510"/><mxPoint x="300" y="510"/></Array></mxGeometry></mxCell><mxCell id="memory" value="TRONG TRẠNG THÁI XÁC NHẬN&#xa;A = đã từng thấy I2 = 1.&#xa;B = đã từng thấy I2 = 1 VÀ I3 = 1 trong cùng một lần cập nhật.&#xa;Giữ A/B dù cảm biến đã nhả; cập nhật cả ở lượt kết thúc xác nhận.&#xa;Bắt đầu lượt chai mới thì ghi lại A/B theo tín hiệu hiện tại." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="345" width="610" height="145" as="geometry"/></mxCell><mxCell id="results" value="KẾT QUẢ KHI ĐỦ 200 ms — ĐỀU CHUYỂN SANG HEAD_WAIT_CLEAR&#xa;• B = 1 VÀ hàng chờ chiết &lt; 255 → thêm 1 yêu cầu chiết; LED xác nhận bật nếu I4 = 0, tắt nếu I4 = 1.&#xa;• B = 1 VÀ hàng chờ chiết = 255 → bỏ yêu cầu; không chuyển sang loại chai.&#xa;• B = 0 VÀ A = 1 → thêm 1 yêu cầu loại nếu hàng chờ loại &lt; 255; nếu đầy thì bỏ yêu cầu.&#xa;• B = 0 VÀ A = 0 → không thêm yêu cầu (chỉ phát hiện I3).&#xa;Khi I4 = 1, LED xác nhận tắt; nếu I4 = 0, LED giữ giá trị đã ghi cho đến lần thay đổi tiếp theo hoặc tắt hệ thống." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="585" width="1220" height="175" as="geometry"/></mxCell><mxCell id="reset" value="Từ bất kỳ trạng thái nào, khi hệ thống chuyển sang TẮT → HEAD_IDLE; chu kỳ xác nhận đang chạy bị hủy." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="765" width="1220" height="30" as="geometry"/></mxCell><mxCell id="legend" value="QUY ƯỚC CHUNG&#xa;I0: START · I1: STOP · I2/I3: cảm biến chai dưới/trên · I4/I5/I6: vị trí chiết/đóng nắp/dán nhãn.&#xa;1 = tác động, 0 = nhả; tín hiệu đã chống dội 20 mẫu liên tiếp. VÀ: phải đủ mọi điều kiện; HOẶC: chỉ cần một điều kiện.&#xa;Nhãn mũi tên: điều kiện → tác động. Nếu chưa thỏa điều kiện chuyển thì giữ trạng thái hiện tại.&#xa;Các máy trạng thái được cập nhật liên tục; các trạm có thể hoạt động đồng thời. Hàng chờ tối đa 255 yêu cầu; đầy thì bỏ yêu cầu mới." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1320" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p4" name="4. Loại chai"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MÁY TRẠNG THÁI TRẠM LOẠI CHAI" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1320" height="45" as="geometry"/></mxCell><mxCell id="sub" value="Mỗi trạm có trạng thái, hàng chờ và thời điểm bắt đầu riêng. Yêu cầu loại được tạo sau khi xác nhận 200 ms: đã thấy I2 nhưng chưa từng thấy I2 và I3 cùng tác động." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="65" as="geometry"/></mxCell><mxCell id="a" value="IDLE&#xa;CHỜ YÊU CẦU&#xa;Cơ cấu trạm tắt" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="240" width="300" height="110" as="geometry"/></mxCell><mxCell id="init" value="" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="210" width="24" height="24" as="geometry"/></mxCell><mxCell id="e1" value="Khởi tạo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="init" target="a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="DOING&#xa;ĐANG LOẠI CHAI&#xa;Bật xi lanh loại chai" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="930" y="240" width="340" height="110" as="geometry"/></mxCell><mxCell id="c" value="WAIT_CLEAR&#xa;CHỜ CẢM BIẾN NHẢ&#xa;Cơ cấu trạm tắt" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="930" y="525" width="340" height="110" as="geometry"/></mxCell><mxCell id="e2" value="Hệ thống BẬT VÀ hàng chờ loại &gt; 0&#xa;&#xa;→ Giảm hàng chờ 1; bật cơ cấu; ghi thời điểm bắt đầu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Thời gian đã chạy ≥ 1.000 ms&#xa;→ Tắt cơ cấu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="I2 = 0&#xa;→ Cho phép nhận lượt tiếp theo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;entryX=0.5;entryY=1;" edge="1" parent="1" source="c" target="a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="580"/><mxPoint x="300" y="580"/></Array></mxGeometry></mxCell><mxCell id="detail" value="ĐIỀU KIỆN VẬN HÀNH&#xa;Trạm loại bắt đầu ngay khi có yêu cầu; không cần I2 = 1.&#xa;I2 chỉ dùng để kiểm tra nhả ở WAIT_CLEAR.&#xa;Trong DOING, cảm biến nhả sớm vẫn tiếp tục đủ 1 giây.&#xa;Không tạo yêu cầu cho trạm tiếp theo.&#xa;WAIT_CLEAR chỉ về IDLE khi I2 = 0; yêu cầu tiếp theo được xét ở lượt cập nhật sau." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="690" height="150" as="geometry"/></mxCell><mxCell id="reset" value="RESET ƯU TIÊN — TỪ BẤT KỲ TRẠNG THÁI NÀO&#xa;Khi hệ thống chuyển sang TẮT (STOP hoặc hết 30 giây) → IDLE.&#xa;Tắt cơ cấu ngay; xóa hàng chờ và mốc thời gian. Chu kỳ đang làm bị hủy, không tiếp tục khi bật lại." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="150" y="680" width="1120" height="100" as="geometry"/></mxCell><mxCell id="legend" value="QUY ƯỚC CHUNG&#xa;I0: START · I1: STOP · I2/I3: cảm biến chai dưới/trên · I4/I5/I6: vị trí chiết/đóng nắp/dán nhãn.&#xa;1 = tác động, 0 = nhả; tín hiệu đã chống dội 20 mẫu liên tiếp. VÀ: phải đủ mọi điều kiện; HOẶC: chỉ cần một điều kiện.&#xa;Nhãn mũi tên: điều kiện → tác động. Nếu chưa thỏa điều kiện chuyển thì giữ trạng thái hiện tại.&#xa;Các máy trạng thái được cập nhật liên tục; các trạm có thể hoạt động đồng thời. Hàng chờ tối đa 255 yêu cầu; đầy thì bỏ yêu cầu mới." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1320" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p5" name="5. Chiết rót"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MÁY TRẠNG THÁI TRẠM CHIẾT RÓT" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1320" height="45" as="geometry"/></mxCell><mxCell id="sub" value="Mỗi trạm có trạng thái, hàng chờ và thời điểm bắt đầu riêng. Yêu cầu chiết được tạo sau khi xác nhận 200 ms: đã thấy I2 và I3 cùng tác động." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="65" as="geometry"/></mxCell><mxCell id="a" value="IDLE&#xa;CHỜ YÊU CẦU&#xa;Cơ cấu trạm tắt" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="240" width="300" height="110" as="geometry"/></mxCell><mxCell id="init" value="" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="210" width="24" height="24" as="geometry"/></mxCell><mxCell id="e1" value="Khởi tạo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="init" target="a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="DOING&#xa;ĐANG CHIẾT RÓT&#xa;Bật van chiết và chặn chai" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="930" y="240" width="340" height="110" as="geometry"/></mxCell><mxCell id="c" value="WAIT_CLEAR&#xa;CHỜ CẢM BIẾN NHẢ&#xa;Cơ cấu trạm tắt" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="930" y="525" width="340" height="110" as="geometry"/></mxCell><mxCell id="e2" value="Hệ thống BẬT VÀ hàng chờ chiết &gt; 0&#xa;VÀ I4 = 1&#xa;→ Giảm hàng chờ 1; bật cơ cấu; ghi thời điểm bắt đầu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Thời gian đã chạy ≥ 5.000 ms&#xa;→ Tắt cơ cấu và tạo yêu cầu đóng nắp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="I4 = 0&#xa;→ Cho phép nhận lượt tiếp theo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;entryX=0.5;entryY=1;" edge="1" parent="1" source="c" target="a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="580"/><mxPoint x="300" y="580"/></Array></mxGeometry></mxCell><mxCell id="detail" value="ĐIỀU KIỆN VẬN HÀNH&#xa;Trạm chỉ bắt đầu khi có yêu cầu VÀ I4 = 1.&#xa;Trong DOING, cảm biến nhả sớm vẫn tiếp tục đủ 5 giây.&#xa;Thêm 1 yêu cầu đóng nắp nếu hàng chờ đóng nắp &lt; 255; đầy thì bỏ yêu cầu.&#xa;WAIT_CLEAR chỉ về IDLE khi I4 = 0; yêu cầu tiếp theo được xét ở lượt cập nhật sau." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="690" height="150" as="geometry"/></mxCell><mxCell id="reset" value="RESET ƯU TIÊN — TỪ BẤT KỲ TRẠNG THÁI NÀO&#xa;Khi hệ thống chuyển sang TẮT (STOP hoặc hết 30 giây) → IDLE.&#xa;Tắt cơ cấu ngay; xóa hàng chờ và mốc thời gian. Chu kỳ đang làm bị hủy, không tiếp tục khi bật lại." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="150" y="680" width="1120" height="100" as="geometry"/></mxCell><mxCell id="legend" value="QUY ƯỚC CHUNG&#xa;I0: START · I1: STOP · I2/I3: cảm biến chai dưới/trên · I4/I5/I6: vị trí chiết/đóng nắp/dán nhãn.&#xa;1 = tác động, 0 = nhả; tín hiệu đã chống dội 20 mẫu liên tiếp. VÀ: phải đủ mọi điều kiện; HOẶC: chỉ cần một điều kiện.&#xa;Nhãn mũi tên: điều kiện → tác động. Nếu chưa thỏa điều kiện chuyển thì giữ trạng thái hiện tại.&#xa;Các máy trạng thái được cập nhật liên tục; các trạm có thể hoạt động đồng thời. Hàng chờ tối đa 255 yêu cầu; đầy thì bỏ yêu cầu mới." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1320" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p6" name="6. Đóng nắp"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MÁY TRẠNG THÁI TRẠM ĐÓNG NẮP" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1320" height="45" as="geometry"/></mxCell><mxCell id="sub" value="Mỗi trạm có trạng thái, hàng chờ và thời điểm bắt đầu riêng. Yêu cầu đóng nắp được tạo khi trạm chiết hoàn tất 5 giây." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="65" as="geometry"/></mxCell><mxCell id="a" value="IDLE&#xa;CHỜ YÊU CẦU&#xa;Cơ cấu trạm tắt" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="240" width="300" height="110" as="geometry"/></mxCell><mxCell id="init" value="" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="210" width="24" height="24" as="geometry"/></mxCell><mxCell id="e1" value="Khởi tạo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="init" target="a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="DOING&#xa;ĐANG ĐÓNG NẮP&#xa;Bật đầu đóng nắp và chặn chai" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="930" y="240" width="340" height="110" as="geometry"/></mxCell><mxCell id="c" value="WAIT_CLEAR&#xa;CHỜ CẢM BIẾN NHẢ&#xa;Cơ cấu trạm tắt" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="930" y="525" width="340" height="110" as="geometry"/></mxCell><mxCell id="e2" value="Hệ thống BẬT VÀ hàng chờ đóng nắp &gt; 0&#xa;VÀ I5 = 1&#xa;→ Giảm hàng chờ 1; bật cơ cấu; ghi thời điểm bắt đầu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Thời gian đã chạy ≥ 2.000 ms&#xa;→ Tắt cơ cấu và tạo yêu cầu dán nhãn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="I5 = 0&#xa;→ Cho phép nhận lượt tiếp theo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;entryX=0.5;entryY=1;" edge="1" parent="1" source="c" target="a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="580"/><mxPoint x="300" y="580"/></Array></mxGeometry></mxCell><mxCell id="detail" value="ĐIỀU KIỆN VẬN HÀNH&#xa;Trạm chỉ bắt đầu khi có yêu cầu VÀ I5 = 1.&#xa;Trong DOING, cảm biến nhả sớm vẫn tiếp tục đủ 2 giây.&#xa;Thêm 1 yêu cầu dán nhãn nếu hàng chờ dán nhãn &lt; 255; đầy thì bỏ yêu cầu.&#xa;WAIT_CLEAR chỉ về IDLE khi I5 = 0; yêu cầu tiếp theo được xét ở lượt cập nhật sau." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="690" height="150" as="geometry"/></mxCell><mxCell id="reset" value="RESET ƯU TIÊN — TỪ BẤT KỲ TRẠNG THÁI NÀO&#xa;Khi hệ thống chuyển sang TẮT (STOP hoặc hết 30 giây) → IDLE.&#xa;Tắt cơ cấu ngay; xóa hàng chờ và mốc thời gian. Chu kỳ đang làm bị hủy, không tiếp tục khi bật lại." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="150" y="680" width="1120" height="100" as="geometry"/></mxCell><mxCell id="legend" value="QUY ƯỚC CHUNG&#xa;I0: START · I1: STOP · I2/I3: cảm biến chai dưới/trên · I4/I5/I6: vị trí chiết/đóng nắp/dán nhãn.&#xa;1 = tác động, 0 = nhả; tín hiệu đã chống dội 20 mẫu liên tiếp. VÀ: phải đủ mọi điều kiện; HOẶC: chỉ cần một điều kiện.&#xa;Nhãn mũi tên: điều kiện → tác động. Nếu chưa thỏa điều kiện chuyển thì giữ trạng thái hiện tại.&#xa;Các máy trạng thái được cập nhật liên tục; các trạm có thể hoạt động đồng thời. Hàng chờ tối đa 255 yêu cầu; đầy thì bỏ yêu cầu mới." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1320" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p7" name="7. Dán nhãn"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MÁY TRẠNG THÁI TRẠM DÁN NHÃN" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1320" height="45" as="geometry"/></mxCell><mxCell id="sub" value="Mỗi trạm có trạng thái, hàng chờ và thời điểm bắt đầu riêng. Yêu cầu dán nhãn được tạo khi trạm đóng nắp hoàn tất 2 giây." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=none;strokeColor=none;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="65" as="geometry"/></mxCell><mxCell id="a" value="IDLE&#xa;CHỜ YÊU CẦU&#xa;Cơ cấu trạm tắt" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="240" width="300" height="110" as="geometry"/></mxCell><mxCell id="init" value="" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="210" width="24" height="24" as="geometry"/></mxCell><mxCell id="e1" value="Khởi tạo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="init" target="a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="DOING&#xa;ĐANG DÁN NHÃN&#xa;Bật bộ dán nhãn" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="930" y="240" width="340" height="110" as="geometry"/></mxCell><mxCell id="c" value="WAIT_CLEAR&#xa;CHỜ CẢM BIẾN NHẢ&#xa;Cơ cấu trạm tắt" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="930" y="525" width="340" height="110" as="geometry"/></mxCell><mxCell id="e2" value="Hệ thống BẬT VÀ hàng chờ dán nhãn &gt; 0&#xa;VÀ I6 = 1&#xa;→ Giảm hàng chờ 1; bật cơ cấu; ghi thời điểm bắt đầu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Thời gian đã chạy ≥ 2.000 ms&#xa;→ Tắt cơ cấu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="I6 = 0&#xa;→ Cho phép nhận lượt tiếp theo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;entryX=0.5;entryY=1;" edge="1" parent="1" source="c" target="a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="580"/><mxPoint x="300" y="580"/></Array></mxGeometry></mxCell><mxCell id="detail" value="ĐIỀU KIỆN VẬN HÀNH&#xa;Trạm chỉ bắt đầu khi có yêu cầu VÀ I6 = 1.&#xa;Trong DOING, cảm biến nhả sớm vẫn tiếp tục đủ 2 giây.&#xa;Không tạo yêu cầu cho trạm tiếp theo.&#xa;WAIT_CLEAR chỉ về IDLE khi I6 = 0; yêu cầu tiếp theo được xét ở lượt cập nhật sau." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="690" height="150" as="geometry"/></mxCell><mxCell id="reset" value="RESET ƯU TIÊN — TỪ BẤT KỲ TRẠNG THÁI NÀO&#xa;Khi hệ thống chuyển sang TẮT (STOP hoặc hết 30 giây) → IDLE.&#xa;Tắt cơ cấu ngay; xóa hàng chờ và mốc thời gian. Chu kỳ đang làm bị hủy, không tiếp tục khi bật lại." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="150" y="680" width="1120" height="100" as="geometry"/></mxCell><mxCell id="legend" value="QUY ƯỚC CHUNG&#xa;I0: START · I1: STOP · I2/I3: cảm biến chai dưới/trên · I4/I5/I6: vị trí chiết/đóng nắp/dán nhãn.&#xa;1 = tác động, 0 = nhả; tín hiệu đã chống dội 20 mẫu liên tiếp. VÀ: phải đủ mọi điều kiện; HOẶC: chỉ cần một điều kiện.&#xa;Nhãn mũi tên: điều kiện → tác động. Nếu chưa thỏa điều kiện chuyển thì giữ trạng thái hiện tại.&#xa;Các máy trạng thái được cập nhật liên tục; các trạm có thể hoạt động đồng thời. Hàng chờ tối đa 255 yêu cầu; đầy thì bỏ yêu cầu mới." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1320" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram>
